{
  "expo": {
    "name": "LectureLens",
    "slug": "lecturelens",
    "version": "1.0.0",
    "scheme": "lecturelens",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.vitumbikokamanga.lecturelens"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow LectureLens to record lecture audio."
        }
      ],
      "expo-asset",
      "expo-stream-audio"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ae0c9bfe-0d51-42bb-a3a4-cfabf10c4964"
      }
    }
  }
}
